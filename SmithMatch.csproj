<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmithMatch</RootNamespace>
    <AssemblyName>SmithMatch</AssemblyName>
    <Version>1.2.0</Version>
    <Product>SmithMatch</Product>
    <Company>Wattlet AS</Company>
    <ApplicationIcon>assets\wattlet.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\wattlet.ico" LogicalName="SmithMatch.icon.ico" />
    <EmbeddedResource Include="assets\wattlet-logo.png" LogicalName="SmithMatch.logo.png" />
  </ItemGroup>

</Project>
